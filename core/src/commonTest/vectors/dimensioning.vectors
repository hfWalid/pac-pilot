# Dimensioning golden vectors — M2-08. STRUCTURED PLACEHOLDERS.
#
# Real shape, provisional numbers. Every expected value here comes from ProvisionalFormulaSet,
# whose coefficients are deliberately non-physical (U-values that RISE with newer construction,
# air's heat capacity at 1.000 instead of ~0.34). Nobody can mistake these for a bareme.
#
# APPEND-ONLY from M2 onward. When the ⚑ gate (PAC-42) lands a validated method, real vectors are
# ADDED and these stay, describing what the provisional method produced.
#
# Note on climate zone: the engine never reads it. The zone selects a base temperature, and M1-04
# resolves that at the boundary into the snapshot, so zone-varying vectors would differ only in a
# field the engine ignores. Zone coverage belongs to whatever resolves DepartementClimate, not here.
#
# Expected values were computed by an independent implementation of the same formula and are not
# transcribed from the engine's output.

[vector]
id          = dimensioning-period-before-1975-001
description = 120 m2, 2,50 m, BEFORE_1975, partial insulation, simple-flux VMC, high-temp radiators
source      = SOURCE_TBD (provisional formula set; superseded when the M2 gate lands a method)
operation   = dimensioning.heatLoad
input.surfaceCentiM2 = 12000
input.ceilingHeightCm = 250
input.constructionPeriod = BEFORE_1975
input.insulationLevel = PARTIAL
input.ventilationType = VMC_SIMPLE_FLUX
input.emitterType = RADIATOR_HIGH_TEMPERATURE
input.baseTemperatureDeciC = -70
input.targetIndoorTemperatureDeciC = 190
expect.outcome = Computed
expect.heatLoad = 19.032
expect.bandMinimum = 17.129
expect.bandMaximum = 22.838
expect.flowTemperature = 50.0
expect.confidence = INDICATIVE

