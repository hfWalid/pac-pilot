operation   = aids.resolve
input.incomeDecile = 9
input.workCostCents = 2000000
input.year = 2025
input.month = 3
input.day = 1
expect.outcome = Resolved
expect.packVersion = sample-2025-H1
expect.tiered = 9000.00
expect.forfait = 500.00
expect.rateBased = 2000.00
expect.totalAids = 11500.00
expect.totalIncludingVat = 22000.00
expect.resteACharge = 10500.00
expect.overGranted = false

